{
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Base16 Default Dark",
  },
  "vim": {
    "use_smartcase_find": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "buffer_font_family": "Inconsolata",
  "lsp": {
    "gopls": {
      "initialization_options": {
        "completeFunctionCalls": false,
      },
    },
  },
}
